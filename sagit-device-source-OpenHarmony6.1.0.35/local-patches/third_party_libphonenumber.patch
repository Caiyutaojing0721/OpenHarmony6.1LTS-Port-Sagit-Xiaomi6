-// Converts string to integer, returns true on success.
-bool StrToInt(const string& s, int32* n) {
-  std::stringstream stream;
-  stream << s;
-  stream >> *n;
-  return !stream.fail();
-}
-
-// Converts integer to string, returns true on success.
-bool IntToStr(int32 n, string* s) {
-  std::stringstream stream;
-  stream << n;
-  stream >> *s;
-  return !stream.fail();
-}
