-// Returns true if s ends with suffix.
-bool EndsWith(const string& s, const string& suffix) {
-  if (suffix.length() > s.length()) {
-    return false;
-  }
-  return std::equal(suffix.rbegin(), suffix.rend(), s.rbegin());
-}
