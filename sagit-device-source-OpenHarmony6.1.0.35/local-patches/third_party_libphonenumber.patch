-void AreaCodeMap::ReadAreaCodeMap(const PrefixDescriptions* descriptions) {
-  DefaultMapStorage* storage = new DefaultMapStorage();
-  storage->ReadFromMap(descriptions);
-  storage_.reset(storage);
-}
