-  EXPECT_TRUE(MaybeStripExtension(&number, &extension));
-  EXPECT_EQ(stripped_number, number);
-  EXPECT_EQ(expected_extension, extension);
-
-  number.assign("1234576 ext.123#");
-  extension.clear();
-  EXPECT_TRUE(MaybeStripExtension(&number, &extension));
-  EXPECT_EQ(stripped_number, number);
-  EXPECT_EQ(expected_extension, extension);
-}
