-TEST_F(PhoneNumberUtilTest, MaybeStripExtension) {
-  // One with extension.
-  string number("1234576 ext. 1234");
-  string extension;
-  string expected_extension("1234");
-  string stripped_number("1234576");
-  EXPECT_TRUE(MaybeStripExtension(&number, &extension));
