ohos_executable("composer_host") {
  sources = [ "//drivers/hdf_core/adapter/uhdf2/host/devhost.c" ]
  include_dirs = [
    "//drivers/hdf_core/adapter/uhdf2/host/include",
    "//drivers/hdf_core/framework/core/host/include",
    "//drivers/hdf_core/adapter/uhdf2/include",
    "//drivers/hdf_core/interfaces",
    "//drivers/hdf_core/interfaces/inner_api/utils",
    "//drivers/hdf_core/interfaces/inner_api/host/shared",
    "//drivers/hdf_core/interfaces/inner_api/host/uhdf",
    "//drivers/hdf_core/interfaces/inner_api/core/shared",
    "//drivers/hdf_core/interfaces/inner_api/osal/shared",
    "//drivers/hdf_core/interfaces/inner_api/osal/uhdf",
    "//drivers/hdf_core/framework/utils/include",
    "//base/startup/init/interfaces/innerkits/include/syspara",
    "//third_party/bounds_checking_function/include",
  ]
  deps = [ "//drivers/hdf_core/adapter/uhdf2/host:libhdf_host" ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hilog:libhilog",
    "init:libbegetutil",
  ]
  output_name = "composer_host"
  install_images = [ "vendor" ]
  module_install_dir = "bin"
  part_name = "qualcomm_products"
  install_enable = true
}

ohos_executable("allocator_host") {
  sources = [ "//drivers/hdf_core/adapter/uhdf2/host/devhost.c" ]
  include_dirs = [
    "//drivers/hdf_core/adapter/uhdf2/host/include",
    "//drivers/hdf_core/framework/core/host/include",
    "//drivers/hdf_core/adapter/uhdf2/include",
