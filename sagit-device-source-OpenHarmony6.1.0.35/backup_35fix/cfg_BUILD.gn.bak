ohos_copy("all_image_conf") {
  sources = [
    "image/system_image_conf.txt",
    "image/updater_image_conf.txt",
    "image/userdata_image_conf.txt",
    "image/vendor_image_conf.txt",
    "image/sys_prod_image_conf.txt",
    "image/chip_prod_image_conf.txt",
  ]
  outputs = [ "${product_output_dir}/imagesconf/{{source_file_part}}" ]
}

ohos_prebuilt_etc("bootanimation_custom_config") {
  source = "etc/bootanimation_custom_config.json"
  module_install_dir = "etc/bootanimation"
  install_enable = true
  install_images = [ sys_prod_base_dir ]
  part_name = "qualcomm_products"
}

group("cfg") {
  deps = [
    ":all_image_conf",
    ":50.usb.rules",
    ":90.feedbackd.rules",
    ":77.mm-qcom-soc.rules",
    ":77.mm-quectel-port-types.rules",
    ":77.mm-sierra.rules",
    ":80.mm-candidate.rules",
    ":display_manager_config",
    ":bt_device_config",
    ":distributed_hardware_components_cfg.json",
    ":dinput_business_event_whitelist.cfg",
    ":fstab.msm8998",
    ":fstab.required",
    ":composer_host",
    ":allocator_host",
    ":hdf_devhost",
    ":hdfdisplay_cfg",
    ":init.msm8998.cfg",
    ":init.msm8998.sh",
    ":init.msm8998.usb.cfg",
    ":ttygs1_shell.sh",
    ":init.cfg",
    ":init.reboot.cfg",
    ":qrtr-ns.cfg",
    ":tqftpserv.cfg",
    ":pd-mapper.cfg",
    ":rmtfs.cfg",
    ":qmi-proxy.cfg",
    # ":dbus-daemon.cfg",
    # ":modem-manager.cfg",
    ":install_list_capability_config",
    ":install_list_config",
    ":install_list_permissions_config",
    ":param_for_chip_prod",
    ":param_for_sys_prod",
    ":param_for_ohos",
    ":sdcard_mount.sh",
    ":selinux_config",
    ":selinux_file_contexts",
    ":udisk_mount.sh",
    ":uninstall_list_config",
    ":window_manager_config",
    ":sagit.conf",
    ":sagit_HiFi.conf",
    ":sagit_VoiceCall.conf",
    ":enchilada.conf",
    ":enchilada_HiFi.conf",
    ":enchilada_VoiceCall.conf",
    ":xiaomi-6-sagit.conf",
    ":xiaomi-6.conf",
    ":bootanimation_custom_config",
  ]
}
