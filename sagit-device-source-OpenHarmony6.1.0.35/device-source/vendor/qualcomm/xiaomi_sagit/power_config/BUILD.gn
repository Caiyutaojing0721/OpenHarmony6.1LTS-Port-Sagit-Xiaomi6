import("//build/ohos.gni")

ohos_prebuilt_etc("power_mode_config") {
  source = "power_mode_config.xml"
  install_images = [
    chipset_base_dir,
    chip_prod_base_dir
  ]
  relative_install_dir = "power_config"
  part_name = "product_xiaomi_sagit"
  install_enable = true
}

ohos_prebuilt_etc("power_suspend_config") {
  source = "power_suspend.json"
  install_images = [
    chipset_base_dir,
    chip_prod_base_dir
  ]
  relative_install_dir = "power_config"
  part_name = "product_xiaomi_sagit"
  install_enable = true
}

ohos_prebuilt_etc("power_wakeup_config") {
  source = "power_wakeup.json"
  install_images = [
    chipset_base_dir,
    chip_prod_base_dir
  ]
  relative_install_dir = "power_config"
  part_name = "product_xiaomi_sagit"
  install_enable = true
}

group("power_config") {
  deps = [
    ":power_mode_config",
    ":power_suspend_config",
    ":power_wakeup_config",
  ]
}
