import("//build/ohos.gni")

ohos_prebuilt_executable("glmark2-es2-ohos") {
  source = "glmark2-es2-ohos"

  install_enable = true
  install_images = [ "vendor" ]
  module_install_dir = "bin"
  part_name = "qualcomm_products"
}

glmark2_models_deps_file = [
  "asteroid-high.3ds",
  "asteroid-low.3ds",
  "bunny.obj",
  "cat.3ds",
  "cube.3ds",
  "horse.3ds",
  "jellyfish.jobj",
]

foreach(name, glmark2_models_deps_file) {
  ohos_prebuilt_etc("${name}") {
    source = "data/models/${name}"
    module_install_dir = "etc/usr/local/share/glmark2/models"
    install_images = [ "system" ]
    part_name = "qualcomm_products"
    install_enable = true
  }
}

glmark2_models_deps = []
foreach(name, glmark2_models_deps_file) {
  glmark2_models_deps += [ ":${name}" ]
}

