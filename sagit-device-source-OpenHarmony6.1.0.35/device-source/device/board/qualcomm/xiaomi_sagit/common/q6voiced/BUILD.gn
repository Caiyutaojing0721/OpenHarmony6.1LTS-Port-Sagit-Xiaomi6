import("//build/ohos.gni")
import("//build/ohos/ndk/ndk.gni")

ohos_executable("q6voiced_ohos") {
  install_enable = true

  sources = [
    "q6voiced.c",
  ]

  include_dirs = [
    "//device/board/qualcomm/xiaomi_sagit/common/tinyalsa/include",
  ]

  deps = [
    "//device/board/qualcomm/xiaomi_sagit/common/tinyalsa:libtinyalsa",
  ]

  part_name = "qualcomm_products"
  install_images = [
    "system",
  ]
  install_enable = true
}

ohos_prebuilt_executable("q6voiced_bin") {
  source = "bin64/q6voiced"
  module_install_dir = "bin"
  install_images = [ "vendor" ]
  part_name = "qualcomm_products"
  install_enable = true
}

ohos_prebuilt_etc("q6voiced_conf") {
  source = "etc/conf.d/q6voiced"
  module_install_dir = "etc/conf.d"
  install_images = [ "system" ]
  part_name = "qualcomm_products"
  install_enable = true
}

ohos_prebuilt_shared_library("libtinyalsa.so.2") {
  source = "lib64/libtinyalsa.so.2"
  module_install_dir = "musl"
  install_images = [ "vendor" ]
  part_name = "qualcomm_products"
  install_enable = true
}

ohos_prebuilt_etc("asound.state") {
  source = "etc/asound.state"
  module_install_dir = "etc"
  install_images = [ "vendor" ]
  part_name = "qualcomm_products"
  install_enable = true
}

group("q6voiced") {
  deps = [
    ":q6voiced_bin",
    ":q6voiced_conf",
    ":libtinyalsa.so.2",
    ":asound.state",
  ]
}