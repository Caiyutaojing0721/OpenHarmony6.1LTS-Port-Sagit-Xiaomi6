import("//build/ohos.gni")
import("//build/ohos/ndk/ndk.gni")

config("libtinyalsa_config") {
  include_dirs = [ "include" ]
  cflags = [
    "-Wno-incompatible-pointer-types",
    "-Werror",
    "-Wimplicit-function-declaration",
    "-Wno-error=unused-variable",
  ]
  cflags = []
}

ohos_shared_library("libtinyalsa") {
  sources = [ "mixer.c",
              "pcm.c",
            ]

  part_name = "qualcomm_products"
  install_images = [
    "system",
    "updater",
  ]
  install_enable = true
  configs = [ ":libtinyalsa_config" ]
}

ohos_executable("tinycap") {
  install_enable = true

  sources = [
    "tinycap.c",
  ]

  configs = [ ":libtinyalsa_config" ]
  deps = [
    ":libtinyalsa",
  ]

  part_name = "qualcomm_products"
  install_images = [
    "system",
    "updater",
  ]
  install_enable = true
}

ohos_executable("tinyplay") {
  install_enable = true

  sources = [
    "tinyplay.c",
  ]

  configs = [ ":libtinyalsa_config" ]
  deps = [
    ":libtinyalsa",
  ]

  part_name = "qualcomm_products"
  install_images = [
    "system",
    "updater",
  ]
  install_enable = true
}

ohos_executable("tinymix") {
  install_enable = true

  sources = [
    "tinymix.c",
  ]

  configs = [ ":libtinyalsa_config" ]
  deps = [
    ":libtinyalsa",
  ]

  part_name = "qualcomm_products"
  install_images = [
    "system",
    "updater",
  ]
  install_enable = true
}

ohos_executable("tinypcminfo") {
  install_enable = true

  sources = [
    "tinypcminfo.c",
  ]

  configs = [ ":libtinyalsa_config" ]
  deps = [
    ":libtinyalsa",
  ]

  part_name = "qualcomm_products"
  install_images = [
    "system",
    "updater",
  ]
  install_enable = true
}

group("tinyalsa") {
  deps = [
    ":tinycap",
    ":tinyplay",
    ":tinymix",
    ":tinypcminfo",
  ]
}
