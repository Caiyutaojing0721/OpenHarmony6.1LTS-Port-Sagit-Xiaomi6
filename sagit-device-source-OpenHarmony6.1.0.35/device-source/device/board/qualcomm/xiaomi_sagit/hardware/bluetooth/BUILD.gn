import("//build/ohos.gni")
import("//build/ohos/ndk/ndk.gni")

config("bt_warnings") {
  cflags = [
    "-Wall",
    "-Werror",
    "-Wno-switch",
    "-Wno-unused-function",
    "-Wno-unused-parameter",
    "-Wno-unused-variable",
    "-Wno-implicit-function-declaration",
    "-Wno-incompatible-pointer-types",
    "-Wno-address-of-packed-member",
    "-Wno-sometimes-uninitialized",
    "-Wno-unused-but-set-variable",
  ]
}

config("cutils_warnings") {
  cflags = [
    "-Wall",
    "-Werror",
    "-Wno-switch",
    "-Wno-unused-function",
    "-Wno-unused-parameter",
    "-Wno-unused-variable",
    "-Wno-implicit-function-declaration",
    "-Wno-incompatible-pointer-types",
  ]
}

sources_cutils = [
  "services/cutils/sockets.cpp",
  "services/cutils/sockets_unix.cpp",
  "services/cutils/socket_network_client_unix.cpp",
  "services/cutils/socket_local_server_unix.cpp",
  "services/cutils/socket_local_client_unix.cpp",
]

ohos_static_library("cutils_static") {
  sources = sources_cutils
  configs = [ ":cutils_warnings" ]
  include_dirs = [ "services/cutils" ]
}

ohos_shared_library("cutils") {
  sources = sources_cutils
  configs = [ ":cutils_warnings" ]
  include_dirs = [ "services/cutils" ]

  install_enable = true
  part_name = "qualcomm_products"
}

ohos_executable("bluetooth_hci") {
  sources = [
    "services/init/bluetooth_hci_service.cpp",
  ]

  cflags = [
    "-Wall",
    "-Werror",
    "-Wno-switch",
    "-Wno-unused-function",
    "-Wno-unused-parameter",
    "-Wno-unused-variable",
    "-Wno-implicit-function-declaration",
    "-Wno-incompatible-pointer-types",
  ]

  include_dirs = [
    "services",
  ]

  deps = [ 
    ":cutils_static"
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]

  install_enable = true
  install_images = [ chipset_base_dir ]
  part_name = "qualcomm_products"
}

ohos_prebuilt_etc("bluetooth_hci.cfg") {
  install_enable = true
  source = "services/etc/bluetooth_hci.cfg"
  module_install_dir = "etc/init"
  install_images = [ chipset_base_dir ]
  part_name = "qualcomm_products"
}

ohos_shared_library("libbt_vendor") {
  output_name = "libbt_vendor"
  sources = [
    "bt_vendor/src/bt_vendor_qcom.c",
    "bt_vendor/src/hardware.c",
    "bt_vendor/src/upio.c",
    "bt_vendor/src/hci_uart.c",
  ]

  include_dirs = [
    "bt_vendor/include",
    "services",
    "//base/hiviewdfx/hilog/interfaces/native/innerkits/include",
    "//foundation/communication/bluetooth/services/bluetooth/hardware/include",
    "//foundation/communication/bluetooth_service/services/bluetooth/hardware/include",
    "//drivers/peripheral/bluetooth/hdi/ohos/hardware/bt/v1_0/server/implement",
  ]

  cflags = [
    "-DUSE_CONTROLLER_BDADDR=TRUE",
    "-DFW_AUTO_DETECTION=TRUE",
    "-DBT_WAKE_VIA_PROC=FALSE",
    "-DSCO_PCM_ROUTING=0",
    "-DSCO_PCM_IF_CLOCK_RATE=1",
    "-DSCO_PCM_IF_FRAME_TYPE=0",
    "-DSCO_PCM_IF_SYNC_MODE=0",
    "-DSCO_PCM_IF_CLOCK_MODE=0",
    "-DPCM_DATA_FMT_SHIFT_MODE=0",
    "-DPCM_DATA_FMT_FILL_BITS=0x03",
    "-DPCM_DATA_FMT_FILL_METHOD=0",
    "-DPCM_DATA_FMT_FILL_NUM=0",
    "-DPCM_DATA_FMT_JUSTIFY_MODE=0",
  ]

  configs = [ ":bt_warnings" ]
  deps = [ ":cutils_static" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]

  install_enable = true
  install_images = [ "system" ]

  part_name = "qualcomm_products"
}

group("bluetooth") {
  public_deps = [
    ":libbt_vendor",
    ":bluetooth_hci",
    ":bluetooth_hci.cfg",
  ]
}
