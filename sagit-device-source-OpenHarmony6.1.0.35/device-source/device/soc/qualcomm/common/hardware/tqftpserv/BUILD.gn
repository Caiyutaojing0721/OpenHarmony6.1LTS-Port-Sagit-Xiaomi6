import("//build/ohos.gni")

ohos_executable("tqftpserv") {
  sources = [
    "tqftpserv.c",
    "translate.c",
  ]

  include_dirs = [ "../qrtr/lib" ]

  deps = [ "../qrtr:libqrtr" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]

  install_images = [ chipset_base_dir ]
  install_enable = true
  part_name = "qualcomm_products"
}

group("tqftpserv_group") {
  deps = [ ":tqftpserv" ]
}
