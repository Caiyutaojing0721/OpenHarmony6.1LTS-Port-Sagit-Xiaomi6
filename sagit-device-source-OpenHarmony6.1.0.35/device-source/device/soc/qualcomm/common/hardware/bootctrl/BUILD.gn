import("//build/ohos.gni")
import("//build/ohos/ndk/ndk.gni")

ohos_shared_library("libqbootctl") {
  include_dirs = [ "include" ]

  sources = [
    "src/bootctrl_impl.cpp",
    "src/gpt-utils.cpp",
    "src/ufs-bsg.cpp",
  ]

  cflags = []
  deps = [ "//third_party/zlib:libz" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]

  install_images = [ chipset_base_dir ]
  install_enable = true
  part_name = "qualcomm_products"
}

ohos_executable("qbootctl") {
  sources = [ "src/bootctl.cpp" ]

  cflags = [ "-Wno-pointer-arith" ]

  include_dirs = [
    "include",
    "//third_party/zlib/contrib/minizip",
  ]

  deps = [
    ":libqbootctl",
    "//third_party/zlib:libz",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]

  install_images = [ chipset_base_dir ]
  install_enable = true
  part_name = "qualcomm_products"
}

group("bootctrl_group") {
  deps = [
    ":libqbootctl",
    ":qbootctl",
  ]
}
